#!/usr/bin/env bash
# Runs the full CI suite before anything becomes public. This is the gate that
# would have caught both failures we pushed to main: an errcheck violation and
# a zone:human bypass.
#
# Enable once per clone:  git config core.hooksPath .githooks
# Bypass deliberately:    git push --no-verify
set -euo pipefail

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

# git feeds refs on stdin as: <local ref> <local sha> <remote ref> <remote sha>
# A deletion has an all-zero local sha and ships no code, so skip the suite.
# Reading nothing at all is NOT treated as "nothing to check": defaulting to
# skip would make the guard silently absent, which is the failure it exists to
# prevent.
saw_ref=0
has_content=0
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  saw_ref=1
  case "$local_sha" in
    *[!0]*) has_content=1 ;;
  esac
done
if [ "$saw_ref" -eq 1 ] && [ "$has_content" -eq 0 ]; then
  echo "pre-push: deletion only, skipping CI gates"
  exit 0
fi

echo "pre-push: running the full CI suite (./scripts/ci.sh)"
echo "          skip deliberately with: git push --no-verify"
echo
exec ./scripts/ci.sh
