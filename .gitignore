# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool
*.out

# Go workspace file
go.work

# Dependency directories
vendor/

# Build output
/bin/
/dist/
/build/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.bak
__pycache__/
*.py[cod]

# Application binary (root directory only)
/comments

# Runtime view state stays local; only the root template and bundle config are source.
**/.comments/
!/.comments/
/.comments/*
!/.comments/templates/
!/.comments/templates/**
!/.comments/bundle.yaml
