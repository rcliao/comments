{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evidence-judgment-v1.schema.json",
  "title": "Draft-derived evidence judgment v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "case_id", "pass", "judge", "findings"],
  "properties": {
    "schema_version": {"const": "evidence-judgment/v1"},
    "case_id": {"type": "string", "minLength": 1},
    "pass": {"type": "integer", "minimum": 1, "maximum": 3},
    "judge": {"$ref": "#/$defs/judge"},
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}}
  },
  "$defs": {
    "judge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "runtime"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "runtime": {"type": "string", "minLength": 1}
      }
    },
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "start_line", "end_line"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "start_line": {"type": "integer", "minimum": 1},
        "end_line": {"type": "integer", "minimum": 1}
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "claim", "verdict", "blocking", "reason", "citations"],
      "properties": {
        "id": {"type": "string", "pattern": "^E[1-9][0-9]*$"},
        "claim": {"type": "string", "minLength": 1},
        "verdict": {"enum": ["supported", "contradicted", "overstated"]},
        "blocking": {"type": "boolean"},
        "reason": {"type": "string", "minLength": 1},
        "thread_id": {"type": "string", "minLength": 1},
        "citations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/citation"}}
      }
    }
  }
}
