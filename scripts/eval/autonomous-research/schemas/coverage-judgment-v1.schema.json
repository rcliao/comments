{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "coverage-judgment-v1.schema.json",
  "title": "Draft-blind coverage judgment v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "case_id", "pass", "judge", "candidates"],
  "properties": {
    "schema_version": {"const": "coverage-judgment/v1"},
    "case_id": {"type": "string", "minLength": 1},
    "pass": {"type": "integer", "minimum": 1, "maximum": 3},
    "judge": {"$ref": "#/$defs/judge"},
    "candidates": {
      "type": "array",
      "items": {"$ref": "#/$defs/candidate"}
    }
  },
  "$defs": {
    "judge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "runtime"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "runtime": {"type": "string", "minLength": 1}
      }
    },
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "start_line", "end_line"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "start_line": {"type": "integer", "minimum": 1},
        "end_line": {"type": "integer", "minimum": 1}
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "question", "expected_answer", "citations"],
      "properties": {
        "id": {"type": "string", "pattern": "^C[1-9][0-9]*$"},
        "question": {"type": "string", "minLength": 1},
        "expected_answer": {"type": "string", "minLength": 1},
        "citations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/citation"}}
      }
    }
  }
}
